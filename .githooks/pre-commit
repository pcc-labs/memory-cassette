#!/bin/bash
#
# Pre-commit hook: ruff lint/format on staged Python files, then the test
# suite with its coverage floor (Postgres-backed cases skip, same as `make test`).
#
# Install with:
#   make hooks
#
# Escape hatches:
#   SKIP_TESTS=1 git commit ...   # lint only
#   git commit --no-verify ...    # skip everything
#

set -e

if ! command -v uv &> /dev/null; then
    echo "uv is not installed; install it or commit with --no-verify."
    exit 1
fi

STAGED_PY_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.py$' || true)

if [ -n "$STAGED_PY_FILES" ]; then
    if ! uv run --quiet ruff check $STAGED_PY_FILES; then
        echo "ruff check failed. Fix with: uv run ruff check --fix $STAGED_PY_FILES"
        exit 1
    fi
    if ! uv run --quiet ruff format --check $STAGED_PY_FILES; then
        echo "Formatting issues. Fix with: uv run ruff format $STAGED_PY_FILES"
        exit 1
    fi
fi

if [[ -z "${SKIP_TESTS}" ]]; then
    if ! uv run --quiet pytest; then
        echo "Tests failed or coverage fell below the floor (see pyproject.toml)."
        echo "To skip tests this once: SKIP_TESTS=1 git commit ..."
        exit 1
    fi
fi
